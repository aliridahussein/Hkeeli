    {
      "id": "unit-2",
      "feature": "u2-p1",
      "order": 2,
      "slug": "ordering-like-a-local",
      "featured": true,
      "level": { "en": "Everyday", "ar": "يوميّات" },
      "title": {
        "en": "Ordering Like a Local",
        "ar": "كيف تطلب متل أهل البلد"
      },
      "description": {
        "en": "Café orders, street food, and how to actually get the bill.",
        "ar": "طلبات القهوة، أكل الشارع، وكيف بتطلب الحساب."
      },
      "tip": {
        "en": "Coffee in Lebanon is ordered by sugar level, not size: 2ahwe sada (no sugar), wasat (medium), 7elwe (sweet). And 3al ri7a literally means \"on the scent\" — barely any sugar at all.",
        "ar": "القهوة بلبنان بتنطلب حسب السكّر مش الحجم: سادة، وسط، حلوة. و\"عالريحة\" يعني سكّر شوي كتير قليل."
      },
      "challenge": {
        "en": "Order a full café run for three people out loud — two coffees at different sugar levels and one manoushe — then ask for the bill.",
        "ar": "اطلب بصوت عالي لتلات أشخاص: قهوتين بدرجات سكّر مختلفة ومنقوشة، وبعدين اطلب الحساب."
      },
      "homework": {
        "en": "Next time you're at a café, order in Lebanese first. If they answer in English, repeat your order in Lebanese anyway.",
        "ar": "أول مرة بتروح عالكافيه، اطلب بالعربي. إذا جاوبوك بالإنجليزي، عيد طلبك بالعربي."
      },
      "dialogue": [
        {
          "speaker": "A",
          "ar": "أهلا وسهلا، شو بتحب؟",
          "translit": "ahla w sahla, shu bt7eb?",
          "en": "Welcome, what would you like?"
        },
        {
          "speaker": "B",
          "ar": "بدي قهوة وسط، من فضلك.",
          "translit": "baddi 2ahwe wasat, min fadlak.",
          "en": "I'd like a medium-sweet coffee, please."
        },
        {
          "speaker": "A",
          "ar": "شي تاني؟",
          "translit": "shi tene?",
          "en": "Anything else?"
        },
        {
          "speaker": "B",
          "ar": "منقوشة زعتر كمان. والحساب لو سمحت.",
          "translit": "man2ushe za3tar kamen. w el 7seb law sama7t.",
          "en": "A zaatar manoushe too. And the bill, please."
        }
      ],
