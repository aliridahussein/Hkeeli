      "order": 1,
      "slug": "first-words",
      "featured": true,
      "level": { "en": "Beginner", "ar": "مبتدئ" },
      "title": {
        "en": "First Words in Lebanon",
        "ar": "أول كلمات بلبنان"
      },
      "description": {
        "en": "Greetings, please & thank you, the basics you need on day one.",
        "ar": "التحيّات، من فضلك وشكراً — الأساسيات يلي بتلزمك من أول يوم."
      },
      "tip": {
        "en": "Lebanese greetings are gendered: you say kifak to a man and kifik to a woman. Get this one right and people immediately hear that you learned from a person, not an app.",
        "ar": "التحية بتتغيّر حسب الشخص: بتقول كيفك لرجّال وكيفِك لمرا. هيدي أول شي بيخلّي الناس تحس إنك تعلّمت من ناس، مش من تطبيق."
      },
      "challenge": {
        "en": "Record a 20-second voice note introducing yourself: greet, say your name, ask how they are, and say goodbye.",
        "ar": "سجّل رسالة صوتية ٢٠ ثانية: سلّم، قول اسمك، اسأل كيفه، وودّع."
      },
      "homework": {
        "en": "Greet three people this week in Lebanese only — no English fallback. Note which reply you didn't understand and bring it to class.",
        "ar": "سلّم على ٣ أشخاص هالأسبوع بالعربي بس. لاحظ شو الجواب يلي ما فهمتو وجيبو عالدرس."
      },
      "dialogue": [
        {
          "speaker": "A",
          "ar": "مرحبا! كيفك؟",
          "translit": "mar7aba! kifak?",
          "en": "Hi! How are you?"
        },
        {
          "speaker": "B",
          "ar": "أهلين، منيح الحمدلله. وإنت؟",
          "translit": "ahlein, mni7 el 7amdilla. w inte?",
          "en": "Hey, I'm good, thank God. And you?"
        },
        {
          "speaker": "A",
          "ar": "منيح كمان. شو أخبارك؟",
          "translit": "mni7 kamen. shu akhbarak?",
          "en": "Good too. What's your news?"
        },
        {
          "speaker": "B",
          "ar": "ماشي الحال. يلا، بخاطرك!",
          "translit": "mashe l-7al. yalla, b khatrak!",
          "en": "Getting by. Alright — see you!"
        }
      ],
      "phrases": [
        {
          "id": "u1-p1",
