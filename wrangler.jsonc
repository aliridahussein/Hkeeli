{
  // Cloudflare deployment config.
  //
  // The site is still plain static files with no build step. The Worker script
  // exists for exactly one route — /api/zee/chat, which holds the Azure key —
  // and hands everything else straight back to the asset server, so pages are
  // delivered the same way they always were.
  //
  // Nothing here affects local development of the pages: `npx serve .` still
  // serves the same files, and serve.json still handles rewrites for that.
  // Zee needs the Worker, so use `npx wrangler dev` when testing her.
  "name": "hkeeli",
  "main": "worker/index.js",

  // Pins the Workers runtime behaviour. Bump it deliberately, never casually —
  // it is not a "last deployed" date.
  "compatibility_date": "2025-01-01",

  // Serve the site on hkeeli.<subdomain>.workers.dev. Without this the deploy
  // succeeds but the site has no address, which is the state the dashboard's
  // half-finished project was left in.
  "workers_dev": true,

  "assets": {
    // The site root is the repo root: index.html sits at the top level.
    // See .assetsignore for the handful of files that are in the repo but are
    // not part of the site.
    "directory": "./",

    // Serves /learn from learn.html, which is what the nav links expect. This
    // is the default, stated explicitly because the whole site depends on it.
    "html_handling": "auto-trailing-slash",

    // Lets worker/index.js fall through to the asset server for every path that
    // isn't /api/…. Without the binding the Worker would have to 404 them.
    "binding": "ASSETS"
  },

  // Zee's system instructions are a .txt file so they can be edited as prose;
  // this rule is what lets the Worker import it as a string. `fallthrough`
  // keeps Wrangler's own default module rules in place underneath it.
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  // Non-secret configuration. The API KEY is NOT here and must never be — set
  // it with `npx wrangler secret put AZURE_OPENAI_API_KEY`. See README.
  "vars": {
    "AZURE_OPENAI_ENDPOINT": "https://ali-ne.services.ai.azure.com/openai/v1",
    "AZURE_OPENAI_DEPLOYMENT": "gpt-5.4-nano"
  }
}
