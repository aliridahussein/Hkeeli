{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hkeeli",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", ".", "-l", "4321"],
      "port": 4321
    },
    {
      "name": "hkeeli-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@4",
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1",
        "--persist-to",
        "C:/Users/user/AppData/Local/Temp/claude/hkeeli-wrangler-state"
      ],
      "port": 8787
    }
  ]
}
