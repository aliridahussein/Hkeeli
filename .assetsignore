# Files that live in the repo but are not part of the published site.
# Everything else under the repo root is uploaded and served as-is.

wrangler.jsonc
.assetsignore
.gitignore
README.md

# Config for other hosts / local tooling — inert on Cloudflare, but no reason
# to serve them.
serve.json
vercel.json
.claude/
node_modules/

# Never serve the repository itself. Deploying from a local folder uploads what
# is on disk, and .git holds the full history.
.git/
.github/
run.cmd

# Zee's server side. The Worker imports these at build time, so they ship inside
# the script — serving them as public files as well would put the instructions
# and the page allowlist one URL away from anyone who guessed the path.
worker/
data/zee/
.dev.vars
.wrangler/
